---
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<Layout center title="2FA Authenticator Extension">
  <div class="grid h-screen place-items-center pb-10">
    <section class="mb-20 flex flex-col gap-8">
      <div class="text-center">
        <div class="flex items-center justify-center gap-4">
          <img src="/img/icon-128.webp" alt="Logo" class="h-16 w-16 md:h-24 md:w-24" />
          <span class="text-6xl font-bold text-gray-700 md:text-7xl dark:text-zinc-200">2FA</span>
        </div>
        <span class="mt-2 text-5xl font-bold text-gray-700 md:text-7xl dark:text-zinc-200">Authenticator</span>
      </div>

      <p class="px-3 text-lg md:text-xl">
        Ya no necesita usar su teléfono para autenticarse. Esta extensión le brinda códigos de verificación de doble
        factor (2FA) directamente en su navegador.
      </p>
      <div class="mt-2 flex flex-col items-center justify-center gap-16 md:mt-4">
        <div class="mt-2 flex flex-wrap items-center justify-center gap-9 md:mt-4">
          <a
            href="https://chromewebstore.google.com/detail/2fa-authenticator/pnnmjhghimefjdmdilmlhnojccjgpgeh"
            class="inline-flex items-center gap-4 rounded-full bg-blue-500 px-7 py-3 text-xl font-semibold uppercase text-white transition duration-300 hover:bg-blue-800 md:text-2xl dark:hover:bg-blue-500"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
              height="192"
              viewBox="0 0 192 192"
              width="192"
              class="h-6 w-6"
              aria-hidden="true"
              ><path d="M0 0h192v192H0z" fill="none"></path><defs
                ><path
                  d="M8 20v140c0 6.6 5.4 12 12 12h152c6.6 0 12-5.4 12-12V20H8zm108 32H76c-4.42 0-8-3.58-8-8s3.58-8 8-8h40c4.42 0 8 3.58 8 8s-3.58 8-8 8z"
                  id="a"></path></defs
              ><clipPath id="b"><use overflow="visible" xlink:href="#a"></use></clipPath><path
                clip-path="url(#b)"
                d="M8 20h176v152H8z"
                fill="#eee"></path><path
                clip-path="url(#b)"
                d="M116 36H76c-4.42 0-8 3.58-8 8s3.58 8 8 8h40c4.42 0 8-3.58 8-8s-3.58 8-8 8z"
                fill="#fff"></path><g clip-path="url(#b)"
                ><defs><circle cx="96" cy="160" id="c" r="76"></circle></defs><clipPath id="d"
                  ><use overflow="visible" xlink:href="#c"></use></clipPath
                ><path
                  clip-path="url(#d)"
                  d="M32.07 84v93.27h34.01L96 125.45h76V84zm0 0v93.27h34.01L96 125.45h76V84z"
                  fill="#DB4437"></path><path
                  clip-path="url(#d)"
                  d="M20 236h72.34l33.58-33.58v-25.14l-59.84-.01L20 98.24zm0 0h72.34l33.58-33.58v-25.14l-59.84-.01L20 98.24z"
                  fill="#0F9D58"></path><path
                  clip-path="url(#d)"
                  d="M96 125.45l29.92 51.82L92.35 236H172V125.45zm0 0l29.92 51.82L92.35 236H172V125.45z"
                  fill="#FFCD40"></path><g clip-path="url(#d)"
                  ><circle cx="96" cy="160" fill="#F1F1F1" r="34.55"></circle><circle
                    cx="96"
                    cy="160"
                    fill="#4285F4"
                    r="27.64"></circle></g
                ></g
              ><path clip-path="url(#b)" d="M8 20h176v76H8z" fill="#212121" fill-opacity=".05"></path><path
                d="M8 95h176v1H8z"
                fill="#212121"
                fill-opacity=".02"></path><path d="M8 96h176v1H8z" fill="#fff" fill-opacity=".05"></path><path
                d="M116 52H76c-4.25 0-7.72-3.32-7.97-7.5-.02.17-.03.33-.03.5 0 4.42 3.58 8 8 8h40c4.42 0 8-3.58 8-8 0-.17-.01-.33-.03-.5-.25 4.18-3.72 7.5-7.97 7.5zM8 20v1h176v-1H8z"
                fill="#212121"
                fill-opacity=".02"></path><path
                d="M76 36h40c4.25 0 7.72 3.32 7.97 7.5.01-.17.03-.33.03-.5 0-4.42-3.58-8-8-8H76c-4.42 0-8 3.58-8 8 0 .17.01.33.03.5.25-4.18 3.72-7.5 7.97-7.5zm96 135H20c-6.6 0-12-5.4-12-12v1c0 6.6 5.4 12 12 12h152c6.6 0 12-5.4 12-12v-1c0 6.6 5.4 12 12 12z"
                fill="#231F20"
                fill-opacity=".1"></path><radialGradient
                cx="7.502"
                cy="19.344"
                gradientUnits="userSpaceOnUse"
                id="e"
                r="227.596"
                ><stop offset="0" stop-color="#fff" stop-opacity=".1"></stop><stop
                  offset="1"
                  stop-color="#fff"
                  stop-opacity="0"></stop></radialGradient
              ><path
                d="M8 20v140c0 6.6 5.4 12 12 12h152c6.6 0 12-5.4 12-12V20H8zm108 32H76c-4.42 0-8-3.58-8-8s3.58-8 8-8h40c4.42 0 8 3.58 8 8s-3.58 8-8 8z"
                fill="url(#e)"></path></svg
            >
            Añadir a Chrome
          </a>
          <a
            href="https://microsoftedge.microsoft.com/addons/detail/2fa-authenticator/hgnbjfcmpjakgfkjmmidclfkhedggmeo"
            class="inline-flex items-center gap-4 rounded-full bg-blue-500 px-7 py-3 text-xl font-semibold uppercase text-white transition duration-300 hover:bg-blue-800 md:text-2xl dark:hover:bg-blue-500"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="72"
              height="72"
              viewBox="0 0 72 72"
              fill="none"
              class="h-6 w-6"
              aria-hidden="true"
            >
              <path d="M34.2 0H0V34.2H34.2V0Z" fill="#f25022"></path>
              <path d="M72.0008 0H37.8008V34.2H72.0008V0Z" fill="#7fba00"></path>
              <path d="M34.2 37.7998H0V71.9998H34.2V37.7998Z" fill="#00a4ef"></path>
              <path d="M72.0008 37.7998H37.8008V71.9998H72.0008V37.7998Z" fill="#ffb900"></path>
            </svg>
            Añadir a Edge
          </a>
        </div>
        <a
          href="/es/docs/"
          class="rounded-full bg-gray-600 px-6 py-3 font-semibold uppercase text-white transition duration-300 hover:bg-gray-700 dark:bg-gray-800 dark:hover:bg-gray-900"
          >Documentación</a
        >
      </div>
    </section>
    <footer class="absolute bottom-0 left-0 right-0 pb-2 text-center text-sm text-gray-600 dark:text-gray-400">
      <a
        href={`/${lang}/privacy`}
        class="text-zinc-800 transition duration-300 hover:text-gray-500 dark:text-gray-500 dark:hover:text-zinc-800"
        >Política de Privacidad y Condiciones del Servicio</a
      >
    </footer>
  </div>
</Layout>
